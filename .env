APP_NAME="ThreatWatch Nigeria"
APP_ENV=local
APP_KEY=base64:oi16/y5Ko8BCNsQ4HewAMFsSVU+xe7QlFarw3CaHElo=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------
# MySQL Database
# ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=threatwatch_ng
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------
# Session & Cache
# ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_DATABASE_TABLE=cache
CACHE_DATABASE_CONNECTION=null
CACHE_PREFIX=threatwatch_

# ----------------------------------------------------------------
# Mail (use Mailpit in local dev)
# ----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@threatwatch.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------
# AWS S3 (for production file storage — optional)
# ----------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------
# Vite
# ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
